FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements.txt ./
RUN --mount=type=secret,id=build_ca \
    if [ -f /run/secrets/build_ca ]; then PIP_CERT=/run/secrets/build_ca pip install --no-cache-dir -r requirements.txt; \
    else pip install --no-cache-dir -r requirements.txt; fi
COPY engine.py platform_adapters.py worker_auth.py server.py worker.py THIRD_PARTY_NOTICES.md ./
ARG SHIYING_UID=1000
RUN useradd --create-home --uid ${SHIYING_UID} shiying && mkdir /data && chown shiying:shiying /data && chmod 644 /app/*.py /app/THIRD_PARTY_NOTICES.md
USER shiying
ENV SHIYING_DATA_DIR=/data SHIYING_COOKIE_DIR=/sessions
EXPOSE 8787
CMD ["uvicorn", "worker:app", "--host", "0.0.0.0", "--port", "8787", "--workers", "1"]
